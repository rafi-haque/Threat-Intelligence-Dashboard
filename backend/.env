# MongoDB connection string (using local MongoDB for development)
MONGODB_URI=mongodb://localhost:27017/tidb

# Data feeds configuration (JSON array of objects)
# Enhanced reliable threat intelligence feeds with better coverage
DATA_FEEDS=[{"id":"feed-1","name":"Feodo Tracker","url":"https://feodotracker.abuse.ch/downloads/ipblocklist.txt","format":"text"},{"id":"feed-2","name":"FireHOL Level 1","url":"https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset","format":"text"},{"id":"feed-3","name":"MalwareBazaar","url":"https://bazaar.abuse.ch/export/txt/sha256/recent/","format":"text"},{"id":"feed-4","name":"GreenSnow","url":"https://blocklist.greensnow.co/greensnow.txt","format":"text"},{"id":"feed-5","name":"URLhaus","url":"https://urlhaus.abuse.ch/downloads/text_recent/","format":"text"},{"id":"feed-6","name":"ThreatFox","url":"https://threatfox.abuse.ch/downloads/ioc_feed.txt","format":"text"},{"id":"feed-7","name":"Maltrail","url":"https://raw.githubusercontent.com/stamparm/maltrail/master/trails/static/malicious/suspicious.txt","format":"text"},{"id":"feed-8","name":"PhishStats","url":"https://phishstats.info/phish_score.csv","format":"csv"},{"id":"feed-9","name":"DigitalSide","url":"https://osint.digitalside.it/Threat-Intel/lists/latestips.txt","format":"text"},{"id":"feed-10","name":"Unit42","url":"https://raw.githubusercontent.com/pan-unit42/iocs/master/diamondfox/diamondfox_panels.txt","format":"text"}]

# Server configuration
PORT=8000
NODE_ENV=development

# Ingestion configuration
ENABLE_INGESTION=true
INGESTION_INTERVAL_MINUTES=30

# Database name (optional, defaults to 'tidb')
DB_NAME=tidb