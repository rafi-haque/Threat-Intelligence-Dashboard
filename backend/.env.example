# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tidb

# Data feeds configuration (JSON array)
DATA_FEEDS=["https://api.threatfeed1.com/indicators.json","https://api.threatfeed2.com/data.json"]

# Server configuration
PORT=8000
NODE_ENV=development

# Ingestion configuration
ENABLE_INGESTION=false
INGESTION_INTERVAL_MINUTES=60

# Database name (optional, defaults to 'tidb')
DB_NAME=tidb