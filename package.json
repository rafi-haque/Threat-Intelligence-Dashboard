{
  "name": "threat-intelligence-dashboard",
  "version": "0.1.0",
  "description": "Threat Intelligence Dashboard - Full Stack Application",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:integration": "cd backend && npm test tests/integration/",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "start": "cd backend && npm start",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "clean": "rm-rf backend/node_modules frontend/node_modules node_modules",
    "populate": "./reset-database.sh --force",
    "reset-db": "node reset-database.js --force",
    "maintenance": "cd backend && node src/maintenance/retention.js",
    "performance": "cd backend && node src/maintenance/stress_check.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "threat-intelligence",
    "dashboard",
    "security",
    "mongodb",
    "react",
    "express"
  ],
  "author": "",
  "license": "MIT"
}